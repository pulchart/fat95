/* DosType-byte partition selection: partition 0 (first    */
/* MBR primary or GPT entry) on a CompactFlash card. The   */
/* last byte of DosType is the partition's place in the    */
/* table plus one: FAT\1 = 0x46415401 = partition 0,       */
/* FAT\4 = last MBR primary, FAT\5 = first logical drive   */
/* (ptable.library 2.1). The device name does not matter.  */
/* Limits: up to FAT\100, at most 12 FAT partitions per    */
/* card. See CF1 for the other way (the device-name        */
/* scheme) and README "Partition Selection".               */
/*                                                         */
/* The FileSystem = l:fat95 line is required by AmigaOS    */
/* Mount even when fat95 is ROM-resident: it satisfies the */
/* parser, and FileSystem.resource dedup ensures the ROM   */
/* SegList is the one DOS actually uses.                   */

FileSystem = l:fat95
Control = "-d-D"
Device = compactflash.device
Unit = 0
Flags = 0
LowCyl = 0
HighCyl = 0
Surfaces = 1
BlocksPerTrack = 1
BlockSize = 512
Buffers = 20
BufMemType = 1
BootPri = 0
Stacksize = 4096
Priority = 5
GlobVec = -1
DosType = 0x46415401
