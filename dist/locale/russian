;fat95 russian localization
;$VER: fat95 install info 3.09 (15.04.2002)

[locale]
;Here come the user interface texts.
;Some of them do contain "wild cards" showing fat95
;where it shall insert special information.
;"%s"  stands for text, like a volume name.
;"%ld" is a signed number, like an error code.
;"%lu" is an (unsigned) disk block number.
;"\n"  makes two text lines out of one.

;The error requester choices.
 1 = Abort
 2 = Skip
 3 = Retry

;Some error messages.
 4 = Please re-insert disk \n"%s"!
 5 = %s:\nread error %ld in block %lu.
 6 = %s:\nwrite error %ld in block %lu.
 7 = %s:\nupdate error.

;Extended datestamp info as file comments.
 8 = created
 9 = last accessed

;The !scandisk feature.
10 = Checking directories...
11 = Checking file allocation table...
12 = Searching for lost files...
13 = %lu error(s) fixed!
14 = Everything fine :)

;The !erase feature.
15 = Erasing free disk space...
16 = Hit <ESC> to abort.


